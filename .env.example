# Production capture (Linux host, AF_XDP-capable NIC/driver)
BAZALT_CAPTURE_MODE=afxdp
BAZALT_INTERFACE=eth0
# Leave empty to discover every rx-* queue from sysfs. Pin an explicit list only
# when RSS/XSK steering is configured to exactly the same queue set.
BAZALT_QUEUE_IDS=
# Native AF_XDP falls back to generic/SKB, then to one libpcap worker when needed.
BAZALT_CAPTURE_FALLBACK_PCAP=true
# Keep kernel/libpcap service-port BPF off by default while capture tuning is deferred.
# Port-only semantics are still enforced immediately in userspace before flow/L7/storage.
BAZALT_EARLY_PORT_FILTER=false

# Adaptive CPU planning is ON by default. BAZALT reads the actual Docker/cgroup
# cpuset and keeps flow/L7/matcher/Tokio inside one machine-wide budget.
# Leave CPU_BUDGET empty for adaptive headroom: all CPUs on <=4-core hosts,
# roughly 75% on larger hosts so DB/kernel/OS retain CPU.
BAZALT_CPU_AUTO=true
BAZALT_CPU_BUDGET=
# Set CPU_AUTO=false only when you intentionally want a manual topology:
# BAZALT_TOKIO_WORKERS=1
# BAZALT_CAPTURE_CPUS=0
# BAZALT_FLOW_CPUS=1,2
# BAZALT_L7_CPUS=3,4
# BAZALT_MATCHER_CPUS=5,6
# BAZALT_FLOW_SHARDS=2
# BAZALT_L7_WORKERS=2
# BAZALT_MATCHER_WORKERS=2
# BAZALT_REPLAY_WORKERS=1
# Capture/data-plane queues are always bounded.
BAZALT_CAPTURE_BATCH=64
# Absorb short scheduler/flow-worker stalls instead of dropping immediately.
# Set 0 only when strict non-blocking capture is more important than completeness.
BAZALT_CAPTURE_ENQUEUE_TIMEOUT_US=250
BAZALT_CAPTURE_QUEUE=32768
BAZALT_FLOW_QUEUE=16384
BAZALT_MATCH_QUEUE=16384
BAZALT_STORAGE_QUEUE=16384
# Persist/update an open flow at most once per interval after payload arrives.
BAZALT_LIVE_FLOW_UPDATE_MS=1000

# v0.4 traffic-fidelity slow paths. Unfragmented traffic never locks the fragment cache.
BAZALT_IP_FRAGMENT_CACHE_BYTES=16777216
BAZALT_IP_FRAGMENT_MAX_DATAGRAMS=4096
BAZALT_IP_FRAGMENT_TIMEOUT_SECS=30
# Decapsulate VXLAN/GRE/IP-in-IP when those transports are visible at the capture point.
BAZALT_TUNNEL_DECAPSULATION=true
# Legacy compatibility only: v0.4 no longer stops a flow after a byte-count threshold.
BAZALT_MAX_FLOW_BYTES=0
# Hard global cap on concurrently tracked flow states. Admission CAS runs only
# when a new tuple is first observed; existing-flow packet processing is unchanged.
BAZALT_MAX_ACTIVE_FLOWS=262144
BAZALT_MAX_OOO_BYTES=4194304
BAZALT_MAX_OOO_SEGMENTS=8192
# Recover a small unresolved TCP capture hole after this age; checked only on OOO state.
BAZALT_TCP_GAP_TIMEOUT_MS=1000

# Optional extra libpcap filter (pcap-live/pcap-file). AF_XDP capture currently
# relies on NIC/RSS + application service/flow processing rather than this expression.
BAZALT_BPF_FILTER=

# Payload/packet logging is intentionally OFF by default.
BAZALT_PACKET_LOGGING=false

# Optional forensic raw PCAP retention. Normalized content is stored regardless.
BAZALT_RAW_CAPTURE=false

# Live IPv4 traffic topology groups observed source addresses automatically.
# /24 matches the common A/D layout where every team owns one IPv4 subnet.
BAZALT_TOPOLOGY_GROUP_PREFIX_V4=24
# Remove a source/group from the live topology after this many idle seconds.
BAZALT_TOPOLOGY_SOURCE_TTL_SECS=300
# Bound live per-source state against spoofed-source cardinality floods.
BAZALT_TOPOLOGY_MAX_SOURCES=65536
# Optional real packet enforcement. Point this at the ingress/forwarding interface
# where packets should actually be dropped. In AF_XDP mode it MUST differ from
# BAZALT_INTERFACE so the enforcement program cannot replace/break the capture XSK.
# Leave empty for topology-only mode.
BAZALT_THROTTLE_INTERFACE=

# Replay yields to live ingestion once live queue pressure reaches this threshold.
BAZALT_REPLAY_PAUSE_PCT=70

# Bounded HTTP content decoding. Both limits must pass: decoded bytes cannot
# exceed the absolute cap or compressed_size * ratio.
BAZALT_HTTP_MAX_DECODE_BYTES=16777216
BAZALT_HTTP_MAX_DECODE_RATIO=32

# Bound match amplification from repetitive payloads/signatures.
BAZALT_MATCH_MAX_HITS_PER_PATTERN=128
BAZALT_MATCH_MAX_HITS_PER_RECORD=1024

# Reject corrupt/oversized segment records before allocation. This must not
# exceed BAZALT_SEGMENT_MAX_BYTES (default 512 MiB).
BAZALT_SEGMENT_MAX_RECORD_BYTES=268435456

# Database credentials are deliberately not shipped with known defaults.
# Generate URL-safe random values before `docker compose up`, e.g.
#   openssl rand -hex 32
BAZALT_POSTGRES_PASSWORD=
BAZALT_CLICKHOUSE_PASSWORD=

# ClickHouse is an asynchronous projection target. Metadata is fsync'd locally
# first so a temporary ClickHouse outage cannot backpressure packet capture.
BAZALT_METADATA_SPOOL_MAX_BYTES=2147483648
BAZALT_CLICKHOUSE_TIMEOUT_MS=5000

RUST_LOG=info
# Control-plane authentication. Enabled by default and fail-closed: when enabled,
# both credentials must be set or BAZALT refuses to start. For local development:
# BAZALT_AUTH_ENABLED=false
BAZALT_AUTH_ENABLED=true
BAZALT_AUTH_USERNAME=admin
BAZALT_AUTH_PASSWORD=
# Session cookie lifetime. Set COOKIE_SECURE=true behind HTTPS.
BAZALT_AUTH_SESSION_SECS=43200
BAZALT_AUTH_COOKIE_SECURE=false

